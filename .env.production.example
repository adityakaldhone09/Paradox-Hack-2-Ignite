# VeriQ production template. Supply real values through the platform secret manager.
APP_NAME=VeriQ
APP_ENV=production
DEBUG=false
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=https://api.your-domain.example
FRONTEND_URL=https://veriq.your-domain.example
CORS_ORIGINS=["https://veriq.your-domain.example"]

# Backend-only secrets: do not expose or commit real values.
DATABASE_URL=postgresql+asyncpg://user:password@db-host:5432/veriq
JWT_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=

STORAGE_DIR=/var/lib/veriq/encrypted_papers
BLOCKCHAIN_MODE=production
BLOCKCHAIN_NETWORK=
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CHAIN_ID=
BLOCKCHAIN_CONTRACT_ADDRESS=
# BLOCKCHAIN_PRIVATE_KEY=

AI_DETECTION_MODE=heuristic
AI_RISK_THRESHOLD=0.75
