{
  "name": "veriq-monorepo",
  "version": "1.0.0",
  "description": "VeriQ — Secure Every Question Paper. Verify Every Action. (WB-03)",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "seed": "cd backend && python scripts/seed_data.py",
    "test:backend": "cd backend && python -m pytest -v",
    "test:frontend": "cd frontend && pnpm run test"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
