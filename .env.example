# ==============================================================================
# VeriQ Environment Configuration
# ==============================================================================
APP_NAME=VeriQ
APP_ENV=development
DEBUG=true

# Comma-separated origins are documented here; configure CORS_ORIGINS as a JSON
# list when supplying it through an environment manager.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Security & Cryptography
# 32-byte hex-encoded key for AES-256-GCM encryption
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=veriq_super_secret_jwt_key_hackathon_demo_2026_secure
JWT_REFRESH_SECRET=veriq_super_secret_refresh_jwt_key_hackathon_demo_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (Defaults to SQLite for instant local dev without daemon)
# For PostgreSQL: postgresql+asyncpg://veriq:veriq_secret@localhost:5432/veriq_db
DATABASE_URL=sqlite+aiosqlite:///./veriq.db

# Redis Cache (Optional for local dev, used in Docker)
REDIS_URL=redis://localhost:6379/0

# Encrypted Off-Chain Document Storage
STORAGE_DIR=./storage/encrypted_papers

# Blockchain Configuration
BLOCKCHAIN_MODE=mock
BLOCKCHAIN_NETWORK=VeriQ-Proof-Ledger-Local
BLOCKCHAIN_RPC_URL=http://localhost:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Production must use a real signing configuration, never the local mock defaults.
# BLOCKCHAIN_PRIVATE_KEY=

# AI Anomaly Detection
AI_DETECTION_MODE=heuristic
AI_RISK_THRESHOLD=0.75
